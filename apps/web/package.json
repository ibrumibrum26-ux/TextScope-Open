{
  "name": "@textscope/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "wasm:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build-wasm.ps1",
    "predev": "npm run wasm:build",
    "dev": "vite",
    "pretypecheck": "npm run wasm:build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run wasm:build",
    "test": "node --test tests/contract.test.ts tests/local-file.test.ts tests/clipboard.test.ts tests/wasm.integration.test.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "prebuild": "npm run wasm:build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "6.0.2",
    "vite": "8.3.5"
  }
}
